---
const skills = [
	"[Skill]",
	"[Skill]",
	"[Skill]",
	"[Skill]",
	"[Skill]",
	"[Skill]",
];
---

<section id="about">
	<h2>Get to know me</h2>

	<ul class="skills">
		{skills.map((skill) => (
			<li>{skill}</li>
		))}
	</ul>

	<p class="quote">"[Things I really enjoy]"</p>

	<p class="role">[Your role] · [Current employer]</p>

	<p>[First bio paragraph — your background and what you focus on]</p>
	<p>[Second bio paragraph — how you work and what you care about]</p>
</section>

<style>
	.skills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
	}

	.skills li {
		border: 2px solid var(--ink);
		border-radius: 999px;
		padding: 0.2rem 0.7rem;
		font-family: var(--font-body);
		font-weight: 700;
		font-size: 0.8rem;
		background: var(--yellow);
	}

	.skills li:nth-child(3n+2) {
		background: var(--sky);
	}

	.skills li:nth-child(3n+3) {
		background: var(--leaf);
	}

	.quote {
		font-family: var(--font-display);
		font-style: italic;
		font-size: 1.3rem;
		color: var(--coral);
	}
</style>
