<section id="about">
	<h2>Get to know me</h2>

	<div class="tabs" role="tablist" aria-label="About me">
		<button type="button" class="tab-button" role="tab" id="tab-day" aria-controls="panel-day" aria-selected="true" data-tab="day">By day</button>
		<button type="button" class="tab-button" role="tab" id="tab-night" aria-controls="panel-night" aria-selected="false" tabindex="-1" data-tab="night">By night</button>
	</div>

	<div class="tab-panels">
		<div class="tab-panel" id="panel-day" role="tabpanel" aria-labelledby="tab-day" data-tab="day">
			<div class="about-copy">
				<p>[Paragraph about a typical day — how I work, what I focus on, the shape of my working hours]</p>
			</div>
			<div class="photo-stack">
				<div class="photo" style="--rot:-6deg; --z:5; top:0px; left:0px;">
					<div class="photo-inner" style="background: var(--yellow);"><span aria-hidden="true">🖼️</span></div>
				</div>
				<div class="photo" style="--rot:4deg; --z:4; top:10px; left:22px;">
					<div class="photo-inner" style="background: var(--sky);"><span aria-hidden="true">🖼️</span></div>
				</div>
				<div class="photo" style="--rot:-3deg; --z:3; top:24px; left:-8px;">
					<div class="photo-inner" style="background: var(--leaf);"><span aria-hidden="true">🖼️</span></div>
				</div>
				<div class="photo" style="--rot:7deg; --z:2; top:16px; left:34px;">
					<div class="photo-inner" style="background: var(--coral);"><span aria-hidden="true">🖼️</span></div>
				</div>
				<div class="photo" style="--rot:-5deg; --z:1; top:32px; left:8px;">
					<div class="photo-inner" style="background: var(--paper);"><span aria-hidden="true">🖼️</span></div>
				</div>
			</div>
		</div>

		<div class="tab-panel" id="panel-night" role="tabpanel" aria-labelledby="tab-night" data-tab="night" hidden>
			<div class="about-copy">
				<p>[Paragraph about evenings and downtime — hobbies, interests, what I get up to outside of work]</p>
			</div>
			<div class="photo-stack">
				<div class="photo" style="--rot:5deg; --z:5; top:0px; left:6px;">
					<div class="photo-inner" style="background: var(--coral);"><span aria-hidden="true">🖼️</span></div>
				</div>
				<div class="photo" style="--rot:-4deg; --z:4; top:14px; left:-6px;">
					<div class="photo-inner" style="background: var(--leaf);"><span aria-hidden="true">🖼️</span></div>
				</div>
				<div class="photo" style="--rot:6deg; --z:3; top:8px; left:30px;">
					<div class="photo-inner" style="background: var(--sky);"><span aria-hidden="true">🖼️</span></div>
				</div>
				<div class="photo" style="--rot:-7deg; --z:2; top:28px; left:12px;">
					<div class="photo-inner" style="background: var(--yellow);"><span aria-hidden="true">🖼️</span></div>
				</div>
				<div class="photo" style="--rot:3deg; --z:1; top:34px; left:-2px;">
					<div class="photo-inner" style="background: var(--paper);"><span aria-hidden="true">🖼️</span></div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.tabs {
		display: flex;
		gap: 1.5rem;
		margin: 1.5rem 0 2rem;
	}

	.tab-button {
		font-family: var(--font-body);
		font-weight: 700;
		font-size: var(--font-size-body);
		padding: 0 0 0.4rem;
		border: none;
		border-bottom: 3px solid transparent;
		background: none;
		color: var(--muted);
		cursor: pointer;
		transition: color 0.15s ease, border-color 0.15s ease;
	}

	.tab-button[aria-selected="true"] {
		color: var(--ink);
		border-bottom-color: var(--coral);
	}

	.tab-panels {
		padding: 0;
	}

	.tab-panel {
		display: flex;
		flex-direction: row-reverse;
		align-items: flex-start;
		gap: 3rem;
	}

	.tab-panel[hidden] {
		display: none;
	}

	.about-copy {
		flex: 1;
		min-width: 0;
	}

	.about-copy p {
		font-family: var(--font-body);
		font-size: var(--font-size-subheading);
	}

	.photo-stack {
		position: relative;
		flex-shrink: 0;
		width: 240px;
		height: 320px;
	}

	.photo {
		position: absolute;
		width: 190px;
		aspect-ratio: var(--ar, 4 / 5);
		border: 3px solid var(--ink);
		background: #fff;
		padding: 0;
		box-shadow: 5px 5px 0 var(--ink);
		cursor: grab;
		touch-action: none;
		user-select: none;
		transform: rotate(var(--rot, 0deg));
		transition: transform 0.15s ease, box-shadow 0.15s ease;
		z-index: var(--z, 1);
	}

	.photo::after {
		content: "⠿";
		position: absolute;
		top: 0.25rem;
		right: 0.5rem;
		font-size: 1rem;
		line-height: 1;
		color: var(--ink);
		opacity: 0.35;
		pointer-events: none;
	}

	.photo:hover:not(.dragging) {
		transform: rotate(var(--rot, 0deg)) translateY(-6px);
		box-shadow: 7px 9px 0 var(--ink);
	}

	.photo.dragging {
		cursor: grabbing;
		box-shadow: 8px 8px 0 var(--ink);
	}

	.photo-inner {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 2.5rem;
	}

	@media (max-width: 768px) {
		.tab-panel {
			flex-direction: column;
			gap: 2rem;
		}

		.photo-stack {
			align-self: center;
		}
	}
</style>

<script>
	const tabButtons = document.querySelectorAll<HTMLButtonElement>(
		"#about .tab-button",
	);
	const tabPanels = document.querySelectorAll<HTMLElement>(
		"#about .tab-panel",
	);

	function setTheme(tab: string | undefined) {
		document.documentElement.setAttribute(
			"data-theme",
			tab === "night" ? "dark" : "light",
		);
	}

	tabButtons.forEach((button) => {
		button.addEventListener("click", () => {
			const target = button.dataset.tab;

			tabButtons.forEach((b) => {
				const selected = b === button;
				b.setAttribute("aria-selected", String(selected));
				b.tabIndex = selected ? 0 : -1;
			});

			tabPanels.forEach((panel) => {
				panel.hidden = panel.dataset.tab !== target;
			});

			setTheme(target);
		});
	});

	// Sync theme to whichever tab is actually marked active at script-run
	// time rather than assuming a fresh light default — the browser's
	// back-forward cache can restore a previously-selected tab's
	// aria-selected state on a reused tab (see CLAUDE.md's bfcache gotcha).
	const activeTab = document.querySelector<HTMLButtonElement>(
		'#about .tab-button[aria-selected="true"]',
	);
	setTheme(activeTab?.dataset.tab);

	let topZ = 10;

	function makeDraggable(el: HTMLElement) {
		const container = el.parentElement;
		if (!container) return;

		let dragging = false;
		let startX = 0;
		let startY = 0;
		let origLeft = 0;
		let origTop = 0;

		el.addEventListener("pointerdown", (e) => {
			dragging = true;
			el.classList.add("dragging");
			el.setPointerCapture(e.pointerId);
			topZ += 1;
			el.style.zIndex = String(topZ);

			const elRect = el.getBoundingClientRect();
			const containerRect = container.getBoundingClientRect();
			origLeft = elRect.left - containerRect.left;
			origTop = elRect.top - containerRect.top;
			startX = e.clientX;
			startY = e.clientY;
		});

		el.addEventListener("pointermove", (e) => {
			if (!dragging) return;
			const dx = e.clientX - startX;
			const dy = e.clientY - startY;
			el.style.left = `${origLeft + dx}px`;
			el.style.top = `${origTop + dy}px`;
		});

		const stopDragging = (e: PointerEvent) => {
			if (!dragging) return;
			dragging = false;
			el.classList.remove("dragging");
			el.releasePointerCapture(e.pointerId);
		};

		el.addEventListener("pointerup", stopDragging);
		el.addEventListener("pointercancel", stopDragging);
	}

	document
		.querySelectorAll<HTMLElement>("#about .photo-stack .photo")
		.forEach(makeDraggable);
</script>
