---
import NowPlayingContent from "./NowPlayingContent.astro";
---

<section id="hero">
	<div class="hero-main">
		<p class="status-badge">Niels Larooij</p>

		<div class="hero-text-row">
			<div class="hero-copy">
				<h1>12+ years of turning messy problems into clean experiences</h1>

				<p class="subhead">
					I zoom out to see the whole picture, then zoom back in to make sure it's actually <strong>pragmatic</strong> to build. <strong>I do my best work shoulder-to-shoulder</strong> with engineers and PMs, with a collaborative, low-ego energy that improves both the process and the output.
				</p>
			</div>

			<div class="illustration-placeholder">
				<img src="/images/avatar.png" alt="Illustrated portrait of me" />
				<p class="drop-hint">Drop here for an easter egg</p>
			</div>
		</div>

		<div class="widgets">
			<aside class="widget" id="now-listening">
				<p class="widget-label">Currently listening</p>
				<NowPlayingContent server:defer>
					<Fragment slot="fallback">
						<p class="widget-body">[Song title]</p>
						<p class="widget-meta">[Artist]</p>
					</Fragment>
				</NowPlayingContent>
			</aside>

			<aside class="widget" id="fun-fact">
				<p class="widget-label">Where I'm at with AI</p>
				<p>
					I built this portfolio using Claude Code, entirely from the
					Terminal, after completing <a
						href="https://aidesignlab.gumroad.com/l/claude-code-for-designers"
						target="_blank"
						rel="noopener noreferrer">Claude Code for Designers</a
					> on Gumroad.
				</p>
			</aside>

			<aside class="widget" id="location">
				<p class="widget-label">Working from</p>
				<p class="widget-body">Amsterdam or Valencia</p>
			</aside>

			<aside class="widget" id="quote">
				<p class="widget-label">Team first</p>
				<blockquote>“When you have a great team and you're having fun, you do great work”</blockquote>
				<p class="widget-meta">— Marc Benioff</p>
			</aside>
		</div>

		<div class="cta-row">
			<a href="#work" class="button">Selected works</a>
			{/* <a href="#about" class="button button--sky">Get to know me</a> — hidden until bio content is filled in */}
			<a href="/resume.pdf" target="_blank" rel="noopener noreferrer" class="button button--paper">View resume <span aria-hidden="true">↗</span></a>
		</div>
	</div>
</section>

<style>
	#hero {
		padding-bottom: 3rem;
	}

	.hero-copy h1 {
		font-size: var(--font-size-display-lg);
	}

	.hero-text-row {
		display: flex;
		align-items: flex-start;
		gap: 2rem;
		margin-bottom: 1.5rem;
	}

	.hero-copy {
		flex: 1;
		min-width: 0;
	}

	.subhead {
		font-family: var(--font-body);
		font-weight: 700;
		font-size: var(--font-size-subheading);
		color: #555;
		margin-top: 0.5rem;
	}

	.subhead strong {
		color: var(--ink);
	}

	.status-badge {
		display: inline-block;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--font-size-overline);
		letter-spacing: 0.02em;
		padding: 0.25rem 1rem;
		margin: 0 0 1rem;
		border: 2px solid var(--ink);
		border-radius: 999px;
		background: var(--paper);
		box-shadow: 3px 3px 0 var(--ink);
	}

	.illustration-placeholder {
		position: relative;
		flex-shrink: 0;
		width: 180px;
		aspect-ratio: 1;
		border-radius: 50%;
		border: 5px solid var(--ink);
		box-shadow: 6px 6px 0 var(--yellow);
		overflow: hidden;
		outline: 0px dashed var(--sky);
		outline-offset: 0px;
		transition: outline-width 0.2s ease, outline-offset 0.2s ease, transform 0.2s ease;
	}

	.drop-hint {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		margin: 0;
		padding: 1rem;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--font-size-caption);
		line-height: 1.2;
		color: #fff;
		background: rgba(26, 26, 26, 0.6);
		opacity: 0;
		transition: opacity 0.2s ease;
		pointer-events: none;
	}

	.illustration-placeholder.drop-active .drop-hint {
		opacity: 1;
	}

	.illustration-placeholder img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.illustration-placeholder.drop-active {
		outline-width: 5px;
		outline-offset: 6px;
		transform: scale(1.06);
		box-shadow: none;
		animation: drop-pulse 1s ease-in-out infinite;
	}

	@keyframes drop-pulse {
		0%, 100% { outline-color: var(--sky); opacity: 1; }
		50% { outline-color: var(--yellow); opacity: 0.5; }
	}

	@media (max-width: 640px) {
		.hero-text-row {
			flex-direction: column-reverse;
		}

		.illustration-placeholder {
			display: none;
		}
	}

	.cta-row {
		display: flex;
		gap: 1rem;
		margin-top: 2rem;
	}

	.widgets {
		position: relative;
		height: 200px;
		margin-top: 1rem;
	}

	.widget {
		position: absolute;
		width: 260px;
		border: 3px solid var(--ink);
		background: #fff59d;
		padding: 1rem;
		font-family: var(--font-body);
		cursor: grab;
		touch-action: none;
		user-select: none;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		box-shadow: 5px 5px 0 var(--ink);
		transform: rotate(var(--rot, 0deg));
		transition: transform 0.15s ease, box-shadow 0.15s ease;
		z-index: var(--z, 1);
	}

	.widget::after {
		content: "⠿";
		position: absolute;
		top: 0.3rem;
		right: 0.6rem;
		font-size: 1.1rem;
		line-height: 1;
		color: var(--ink);
		opacity: 0.35;
		pointer-events: none;
	}

	.widget:hover:not(.dragging) {
		transform: rotate(var(--rot, 0deg)) translateY(-6px);
		box-shadow: 7px 9px 0 var(--ink);
		z-index: 20;
	}

	.widget.popping {
		animation: pop-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.widget.popping-out {
		animation: pop-out 0.5s ease-in;
		animation-fill-mode: forwards;
	}

	@keyframes pop-in {
		0% {
			transform: rotate(var(--rot, 0deg)) scale(0);
			opacity: 0;
		}
		60% {
			transform: rotate(var(--rot, 0deg)) scale(1.15);
			opacity: 1;
		}
		100% {
			transform: rotate(var(--rot, 0deg)) scale(1);
			opacity: 1;
		}
	}

	@keyframes pop-out {
		0% {
			transform: rotate(var(--rot, 0deg)) scale(1);
			opacity: 1;
		}
		100% {
			transform: rotate(var(--rot, 0deg)) scale(0);
			opacity: 0;
		}
	}

	.widget.dragging {
		cursor: grabbing;
		z-index: 10;
		box-shadow: 8px 8px 0 var(--ink);
	}

	.widget-label {
		font-family: var(--font-display);
		font-weight: 700;
		margin: 0;
	}

	.widget-body,
	.widget-meta {
		margin: 0;
	}

	.widget p {
		margin: 0;
	}

	.widget blockquote {
		margin: 0;
	}

	#now-listening {
		--z: 4;
		--rot: -3deg;
	}

	#fun-fact {
		--z: 3;
		--rot: 4deg;
		background: #c5e1a5;
	}

	#location {
		--z: 2;
		--rot: -1.5deg;
		background: #b3e5fc;
	}

	#quote {
		--z: 1;
		--rot: 2deg;
		background: #ffccbc;
	}

	/* Fan-out coordinates only apply at desktop widths. Below this, JS
	   (layoutWidgetsForViewport()) sets left/top/width inline once it
	   runs — but without this gate, the fanned left:630px etc. would
	   apply from the very first paint (before any script executes),
	   overflowing narrow viewports. Some mobile browsers react to that
	   momentary overflow by widening their own layout viewport past the
	   900px breakpoint, so by the time the script runs it thinks it's on
	   desktop and never fixes anything. Keeping the desktop coordinates
	   CSS-gated means there's no overflow to react to in the first place. */
	@media (min-width: 901px) {
		#now-listening {
			top: 0;
			left: 630px;
		}

		#fun-fact {
			top: 0;
			left: 420px;
		}

		#location {
			top: 0;
			left: 210px;
		}

		#quote {
			top: 0;
			left: 0px;
		}
	}

	/* Below the desktop fan-out width, widgets stay absolutely positioned
	   (so dragging keeps working) but are stacked vertically instead of
	   fanned out — see layoutWidgetsForViewport() in the script below,
	   which computes each card's stacked top from its actual rendered
	   height so cards of any content length never overlap. */
	@media (max-width: 900px) {
		.widget {
			width: min(100%, 260px);
		}
	}
</style>

<script>
	const illustration = document.querySelector<HTMLElement>(
		".illustration-placeholder",
	);

	const WIDGETS_STACK_BREAKPOINT = 900;
	const widgetsContainer = document.querySelector<HTMLElement>(".widgets");
	// Flow order matches the desktop fan-out's left-to-right visual order
	// (#quote is leftmost, #now-listening rightmost) rather than raw DOM
	// order, so wrapping on narrow screens follows the same left-to-right
	// reading order the desktop layout already implies.
	const WIDGET_FLOW_ORDER = ["quote", "location", "fun-fact", "now-listening"];
	const widgetEls = WIDGET_FLOW_ORDER
		.map((id) => document.getElementById(id))
		.filter((el): el is HTMLElement => el !== null);

	const NATURAL_WIDGET_WIDTH = 260;

	// Below the desktop fan-out width, widgets flow left-to-right — as many
	// per row as fit — and only wrap to the next row once a card would
	// overflow the container, instead of fanning out at fixed pixel
	// coordinates. They stay position: absolute (not static) throughout so
	// the pointer-drag logic below keeps working at every viewport size.
	function layoutWidgetsForViewport() {
		if (!widgetsContainer) return;

		if (window.innerWidth < WIDGETS_STACK_BREAKPOINT) {
			const gap = 24;
			const containerWidth = widgetsContainer.clientWidth;

			// If even two natural-width cards can't fit side by side, we're
			// in single-column mode — let cards fill the full width instead
			// of sitting at a fixed 260px with empty space beside them.
			const singleColumn = containerWidth < NATURAL_WIDGET_WIDTH * 2 + gap;
			for (const el of widgetEls) {
				el.style.width = singleColumn ? "100%" : "";
			}

			let x = 0;
			let y = 0;
			let rowHeight = 0;
			for (const el of widgetEls) {
				const w = el.offsetWidth;
				const h = el.offsetHeight;
				if (x > 0 && x + w > containerWidth) {
					x = 0;
					y += rowHeight + gap;
					rowHeight = 0;
				}
				el.style.left = `${x}px`;
				el.style.top = `${y}px`;
				x += w + gap;
				rowHeight = Math.max(rowHeight, h);
			}
			widgetsContainer.style.height = `${y + rowHeight}px`;
		} else {
			// Restore desktop layout: clear inline overrides so the per-ID
			// fixed coordinates in the stylesheet take over again.
			for (const el of widgetEls) {
				el.style.left = "";
				el.style.top = "";
				el.style.width = "";
			}
			widgetsContainer.style.height = "";
		}
	}

	layoutWidgetsForViewport();
	window.addEventListener("load", layoutWidgetsForViewport);

	let resizeTimer: ReturnType<typeof setTimeout>;
	window.addEventListener("resize", () => {
		clearTimeout(resizeTimer);
		resizeTimer = setTimeout(layoutWidgetsForViewport, 100);
	});

	function spawnEasterEgg(onGone?: () => void) {
		const egg = document.createElement("div");
		egg.className = "easter-egg";

		const img = document.createElement("img");
		img.src = "/images/easter-egg.png";
		img.alt = "A hidden Easter egg";
		egg.appendChild(img);

		const size = 120;
		const maxLeft = Math.max(window.innerWidth - size, 0);
		const maxTop = Math.max(window.innerHeight - size, 0);
		egg.style.left = `${Math.random() * maxLeft}px`;
		egg.style.top = `${Math.random() * maxTop}px`;

		document.body.appendChild(egg);

		let dismissed = false;
		const dismiss = () => {
			if (dismissed) return;
			dismissed = true;
			clearTimeout(autoTimer);
			egg.classList.add("leaving");
			egg.addEventListener(
				"animationend",
				() => {
					egg.remove();
					onGone?.();
				},
				{ once: true },
			);
		};

		const removeButton = document.createElement("button");
		removeButton.type = "button";
		removeButton.className = "easter-egg-remove";
		removeButton.textContent = "Remove";
		removeButton.addEventListener("click", (e) => {
			e.stopPropagation();
			dismiss();
		});
		egg.appendChild(removeButton);

		egg.addEventListener("click", dismiss);
		const autoTimer = setTimeout(dismiss, 2500);
	}

	function makeDraggable(el: HTMLElement) {
		const container = el.parentElement;
		if (!container) return;

		let dragging = false;
		let startX = 0;
		let startY = 0;
		let origLeft = 0;
		let origTop = 0;

		el.addEventListener("pointerdown", (e) => {
			if ((e.target as HTMLElement).closest("summary, a")) return;

			dragging = true;
			el.classList.add("dragging");
			illustration?.classList.add("drop-active");
			el.setPointerCapture(e.pointerId);

			const elRect = el.getBoundingClientRect();
			const containerRect = container.getBoundingClientRect();
			origLeft = elRect.left - containerRect.left;
			origTop = elRect.top - containerRect.top;
			startX = e.clientX;
			startY = e.clientY;
		});

		el.addEventListener("pointermove", (e) => {
			if (!dragging) return;
			const dx = e.clientX - startX;
			const dy = e.clientY - startY;
			el.style.left = `${origLeft + dx}px`;
			el.style.top = `${origTop + dy}px`;
		});

		const stopDragging = (e: PointerEvent) => {
			if (!dragging) return;
			dragging = false;
			el.classList.remove("dragging");
			illustration?.classList.remove("drop-active");
			el.releasePointerCapture(e.pointerId);

			if (illustration) {
				const widgetRect = el.getBoundingClientRect();
				const illRect = illustration.getBoundingClientRect();
				const overlaps =
					widgetRect.right > illRect.left &&
					widgetRect.left < illRect.right &&
					widgetRect.bottom > illRect.top &&
					widgetRect.top < illRect.bottom;

				if (overlaps) {
					el.classList.add("popping-out");
					el.addEventListener(
						"animationend",
						() => {
							el.classList.remove("popping-out");
							el.style.display = "none";
							el.style.left = "";
							el.style.top = "";

							spawnEasterEgg(() => {
								el.style.display = "";
								el.classList.add("popping");
								el.addEventListener(
									"animationend",
									() => {
										el.classList.remove("popping");
									},
									{ once: true },
								);
							});
						},
						{ once: true },
					);
				}
			}
		};

		el.addEventListener("pointerup", stopDragging);
		el.addEventListener("pointercancel", stopDragging);
	}

	document
		.querySelectorAll<HTMLElement>(".widgets .widget")
		.forEach(makeDraggable);
</script>
