---
import { getLastPlayed } from "../lib/spotify";

const nowPlaying = await getLastPlayed();
---

<section id="hero">
	<div class="hero-main">
		<p class="status-badge">Niels Larooij</p>

		<div class="hero-text-row">
			<div class="hero-copy">
				<h1>12+ years of turning messy problems into clean experiences</h1>

				<p class="subhead">
					I zoom out to see the whole picture, then zoom back in to make sure it's actually <strong>pragmatic</strong> to build. <strong>I do my best work shoulder-to-shoulder</strong> with engineers and PMs, with a collaborative, low-ego energy that improves both the process and the output.
				</p>
			</div>

			<div class="illustration-placeholder">
				<img src="/images/avatar.png" alt="Illustrated portrait of me" />
				<p class="drop-hint">Drop here for an easter egg</p>
			</div>
		</div>

		<div class="widgets">
			<aside
				class:list={["widget", "flip-card", { "is-playing": nowPlaying?.isPlaying }]}
				id="now-listening"
			>
				<div class="flip-card-inner">
					<div class="flip-card-front">
						<p class="widget-label">Currently listening</p>
						<p>Hover to see</p>
						<p class="widget-fineprint">Yes, it's really connected to my Spotify</p>
					</div>
					<div class="flip-card-back">
						{nowPlaying ? (
							<>
							<p class="widget-label">Currently listening</p>
							<iframe
								class="spotify-embed"
								src={`https://open.spotify.com/embed/track/${nowPlaying.id}?utm_source=generator&theme=0`}
								width="100%"
								height="80"
								frameborder="0"
								allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
								loading="lazy"
								title={`${nowPlaying.title} — ${nowPlaying.artist}`}
							/>
							</>
						) : (
							<>
								<p class="widget-label">Currently listening</p>
								<p class="widget-body">[Song title]</p>
								<p class="widget-meta">[Artist]</p>
							</>
						)}
					</div>
				</div>
			</aside>

			<aside class="widget" id="fun-fact">
				<p class="widget-label">Fun fact</p>
				<p>
					I've created this whole portfolio through Terminal and Claude Code
					after finishing the <a
						href="https://aidesignlab.gumroad.com/l/claude-code-for-designers"
						target="_blank"
						rel="noopener noreferrer">Claude Code for Designers</a
					> course from Gumroad.
				</p>
			</aside>

			<aside class="widget" id="location">
				<p class="widget-label">Working from</p>
				<p class="widget-body">Amsterdam or Valencia</p>
			</aside>

			<aside class="widget" id="quote">
				<p class="widget-label">What I'm looking for</p>
				<blockquote>“When you have a great team and you're having fun, you do great work”</blockquote>
				<p class="widget-meta">— Marc Benioff</p>
			</aside>
		</div>

		<div class="cta-row">
			<a href="#work" class="button">Selected works</a>
			{/* <a href="#about" class="button button--sky">Get to know me</a> — hidden until bio content is filled in */}
			<a href="#" class="button button--coral">View resume</a>
		</div>
	</div>
</section>

<style>
	#hero {
		padding-bottom: 3rem;
	}

	.hero-copy h1 {
		font-size: 4rem;
	}

	.hero-text-row {
		display: flex;
		align-items: flex-start;
		gap: 2rem;
		margin-bottom: 1.5rem;
	}

	.hero-copy {
		flex: 1;
		min-width: 0;
	}

	.subhead {
		font-family: var(--font-body);
		font-weight: 700;
		font-size: 1.25rem;
		color: #555;
		margin-top: 0.5rem;
	}

	.subhead strong {
		color: var(--ink);
	}

	.status-badge {
		display: inline-block;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.8rem;
		letter-spacing: 0.02em;
		padding: 0.35rem 0.9rem;
		margin: 0 0 1rem;
		border: 2px solid var(--ink);
		border-radius: 999px;
		background: var(--leaf);
		box-shadow: 3px 3px 0 var(--ink);
	}

	.illustration-placeholder {
		position: relative;
		flex-shrink: 0;
		width: 180px;
		aspect-ratio: 1;
		border-radius: 50%;
		border: 5px solid var(--ink);
		box-shadow: 6px 6px 0 var(--yellow);
		overflow: hidden;
		outline: 0px dashed var(--sky);
		outline-offset: 0px;
		transition: outline-width 0.2s ease, outline-offset 0.2s ease, transform 0.2s ease;
	}

	.drop-hint {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		margin: 0;
		padding: 1rem;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.85rem;
		line-height: 1.2;
		color: #fff;
		background: rgba(26, 26, 26, 0.6);
		opacity: 0;
		transition: opacity 0.2s ease;
		pointer-events: none;
	}

	.illustration-placeholder.drop-active .drop-hint {
		opacity: 1;
	}

	.illustration-placeholder img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.illustration-placeholder.drop-active {
		outline-width: 5px;
		outline-offset: 6px;
		transform: scale(1.06);
		box-shadow: none;
		animation: drop-pulse 1s ease-in-out infinite;
	}

	@keyframes drop-pulse {
		0%, 100% { outline-color: var(--sky); opacity: 1; }
		50% { outline-color: var(--yellow); opacity: 0.5; }
	}

	@media (max-width: 640px) {
		.hero-text-row {
			flex-direction: column-reverse;
		}
	}

	.cta-row {
		display: flex;
		gap: 1rem;
		margin-top: 2.25rem;
	}

	.widgets {
		position: relative;
		height: 200px;
		margin-top: 1rem;
	}

	.widget {
		position: absolute;
		width: 260px;
		border: 3px solid var(--ink);
		background: #fff59d;
		padding: 1rem;
		font-family: var(--font-body);
		cursor: grab;
		touch-action: none;
		user-select: none;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		box-shadow: 5px 5px 0 var(--ink);
		transform: rotate(var(--rot, 0deg));
		transition: transform 0.15s ease, box-shadow 0.15s ease;
		z-index: var(--z, 1);
	}

	.widget:not(.flip-card)::after {
		content: "⠿";
		position: absolute;
		top: 0.3rem;
		right: 0.6rem;
		font-size: 1.1rem;
		line-height: 1;
		color: var(--ink);
		opacity: 0.35;
		pointer-events: none;
	}

	.flip-card-front::after,
	.flip-card-back::after {
		content: "⠿";
		position: absolute;
		top: 0.3rem;
		right: 0.6rem;
		font-size: 1.1rem;
		line-height: 1;
		color: var(--ink);
		opacity: 0.35;
		pointer-events: none;
	}

	.widget:hover:not(.dragging) {
		transform: rotate(var(--rot, 0deg)) translateY(-6px);
		box-shadow: 7px 9px 0 var(--ink);
		z-index: 20;
	}

	.widget:hover:not(.dragging).flip-card {
		box-shadow: none;
	}

	.widget.popping {
		animation: pop-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.widget.popping-out {
		animation: pop-out 0.5s ease-in;
		animation-fill-mode: forwards;
	}

	@keyframes pop-in {
		0% {
			transform: rotate(var(--rot, 0deg)) scale(0);
			opacity: 0;
		}
		60% {
			transform: rotate(var(--rot, 0deg)) scale(1.15);
			opacity: 1;
		}
		100% {
			transform: rotate(var(--rot, 0deg)) scale(1);
			opacity: 1;
		}
	}

	@keyframes pop-out {
		0% {
			transform: rotate(var(--rot, 0deg)) scale(1);
			opacity: 1;
		}
		100% {
			transform: rotate(var(--rot, 0deg)) scale(0);
			opacity: 0;
		}
	}

	.widget.dragging {
		cursor: grabbing;
		z-index: 10;
		box-shadow: 8px 8px 0 var(--ink);
	}

	.widget.dragging.flip-card {
		box-shadow: none;
	}

	.widget.dragging .flip-card-front,
	.widget.dragging .flip-card-back {
		box-shadow: 8px 8px 0 var(--ink);
	}

	.widget-label {
		font-family: var(--font-display);
		font-weight: 700;
		margin: 0;
	}

	.widget-body,
	.widget-meta {
		margin: 0;
	}

	.widget p {
		margin: 0;
	}

	.widget-fineprint {
		margin: 0;
		font-size: 0.75rem;
		opacity: 0.65;
	}

	.widget blockquote {
		margin: 0;
	}

	.widget.flip-card {
		border: none;
		background: none;
		padding: 0;
		box-shadow: none;
	}

	.flip-card {
		perspective: 1000px;
	}

	.flip-card .flip-card-inner {
		position: relative;
		width: 100%;
		transition: transform 0.6s;
		transform-style: preserve-3d;
	}

	.flip-card:hover .flip-card-inner,
	.flip-card.is-playing .flip-card-inner {
		transform: rotateY(180deg);
	}

	.flip-card-front,
	.flip-card-back {
		box-sizing: border-box;
		border: 3px solid var(--ink);
		background: #ffccbc;
		padding: 1rem;
		box-shadow: 5px 5px 0 var(--ink);
		backface-visibility: hidden;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.flip-card-front p,
	.flip-card-back p {
		margin: 0;
	}

	.spotify-embed {
		border: none;
		border-radius: 8px;
		display: block;
	}

	.flip-card-back a {
		font-weight: 700;
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.flip-card-front {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
	}

	.flip-card-back {
		transform: rotateY(180deg);
	}

	#now-listening {
		top: 0;
		left: 0;
		width: 320px;
		--z: 1;
		--rot: -3deg;
	}

	#now-listening .flip-card-front,
	#now-listening .flip-card-back {
		background: #fff59d;
	}

	#fun-fact {
		top: 0;
		left: 630px;
		--z: 4;
		--rot: 4deg;
		background: #c5e1a5;
	}

	#location {
		top: 0;
		left: 420px;
		--z: 3;
		--rot: -1.5deg;
		background: #b3e5fc;
	}

	#quote {
		top: 0;
		left: 210px;
		--z: 2;
		--rot: 2deg;
		background: #ffccbc;
	}
</style>

<script>
	const illustration = document.querySelector<HTMLElement>(
		".illustration-placeholder",
	);

	function spawnEasterEgg(onGone?: () => void) {
		const egg = document.createElement("div");
		egg.className = "easter-egg";

		const img = document.createElement("img");
		img.src = "/images/easter-egg.png";
		img.alt = "A hidden Easter egg";
		egg.appendChild(img);

		const size = 120;
		const maxLeft = Math.max(window.innerWidth - size, 0);
		const maxTop = Math.max(window.innerHeight - size, 0);
		egg.style.left = `${Math.random() * maxLeft}px`;
		egg.style.top = `${Math.random() * maxTop}px`;

		document.body.appendChild(egg);

		let dismissed = false;
		const dismiss = () => {
			if (dismissed) return;
			dismissed = true;
			clearTimeout(autoTimer);
			egg.classList.add("leaving");
			egg.addEventListener(
				"animationend",
				() => {
					egg.remove();
					onGone?.();
				},
				{ once: true },
			);
		};

		const removeButton = document.createElement("button");
		removeButton.type = "button";
		removeButton.className = "easter-egg-remove";
		removeButton.textContent = "Remove";
		removeButton.addEventListener("click", (e) => {
			e.stopPropagation();
			dismiss();
		});
		egg.appendChild(removeButton);

		egg.addEventListener("click", dismiss);
		const autoTimer = setTimeout(dismiss, 2500);
	}

	function makeDraggable(el: HTMLElement) {
		const container = el.parentElement;
		if (!container) return;

		let dragging = false;
		let startX = 0;
		let startY = 0;
		let origLeft = 0;
		let origTop = 0;

		el.addEventListener("pointerdown", (e) => {
			if ((e.target as HTMLElement).closest("summary, a")) return;

			dragging = true;
			el.classList.add("dragging");
			illustration?.classList.add("drop-active");
			el.setPointerCapture(e.pointerId);

			const elRect = el.getBoundingClientRect();
			const containerRect = container.getBoundingClientRect();
			origLeft = elRect.left - containerRect.left;
			origTop = elRect.top - containerRect.top;
			startX = e.clientX;
			startY = e.clientY;
		});

		el.addEventListener("pointermove", (e) => {
			if (!dragging) return;
			const dx = e.clientX - startX;
			const dy = e.clientY - startY;
			el.style.left = `${origLeft + dx}px`;
			el.style.top = `${origTop + dy}px`;
		});

		const stopDragging = (e: PointerEvent) => {
			if (!dragging) return;
			dragging = false;
			el.classList.remove("dragging");
			illustration?.classList.remove("drop-active");
			el.releasePointerCapture(e.pointerId);

			if (illustration) {
				const widgetRect = el.getBoundingClientRect();
				const illRect = illustration.getBoundingClientRect();
				const overlaps =
					widgetRect.right > illRect.left &&
					widgetRect.left < illRect.right &&
					widgetRect.bottom > illRect.top &&
					widgetRect.top < illRect.bottom;

				if (overlaps) {
					el.classList.add("popping-out");
					el.addEventListener(
						"animationend",
						() => {
							el.classList.remove("popping-out");
							el.style.display = "none";
							el.style.left = "";
							el.style.top = "";

							spawnEasterEgg(() => {
								el.style.display = "";
								el.classList.add("popping");
								el.addEventListener(
									"animationend",
									() => {
										el.classList.remove("popping");
									},
									{ once: true },
								);
							});
						},
						{ once: true },
					);
				}
			}
		};

		el.addEventListener("pointerup", stopDragging);
		el.addEventListener("pointercancel", stopDragging);
	}

	document
		.querySelectorAll<HTMLElement>(".widgets .widget")
		.forEach(makeDraggable);
</script>
