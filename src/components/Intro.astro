---
const introText = "“All life is problem solving.” — Karl Popper";
const words = introText.split(" ");
---

<div id="intro-overlay" aria-hidden="true">
	<p id="intro-text">
		{words.map((word) => <span>{word}&nbsp;</span>)}
	</p>
</div>

<style>
	#intro-overlay {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #fff;
		padding: 1.5rem;
		text-align: center;
		transition: opacity 0.6s ease;
	}

	#intro-overlay.hidden {
		opacity: 0;
		pointer-events: none;
	}

	#intro-text {
		max-width: 40rem;
		font-size: 1.5rem;
		margin: 0;
	}

	#intro-text span {
		display: inline-block;
		opacity: 0;
		transform: translateY(0.4em);
		filter: blur(4px);
		transition: opacity 0.5s ease, transform 0.5s ease, filter 0.5s ease;
	}

	#intro-text span.visible {
		opacity: 1;
		transform: translateY(0);
		filter: blur(0);
	}
</style>

<script>
	const overlay = document.getElementById("intro-overlay");
	const pageContent = document.getElementById("page-content");
	const words = document.querySelectorAll<HTMLElement>("#intro-text span");
	const prefersReducedMotion = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	).matches;

	if (!overlay || words.length === 0) {
		pageContent?.classList.add("revealed");
	} else if (prefersReducedMotion) {
		overlay.classList.add("hidden");
		pageContent?.classList.add("revealed");
	} else {
		document.body.style.overflow = "hidden";

		const stepMs = 120;
		words.forEach((word, i) => {
			setTimeout(() => word.classList.add("visible"), i * stepMs);
		});

		const totalDelay = words.length * stepMs + 700;
		setTimeout(() => {
			overlay.classList.add("hidden");
			pageContent?.classList.add("revealed");
			document.body.style.overflow = "";
		}, totalDelay);
	}
</script>
