---
const quote =
	"“When you have a great team and you’re having fun, you do great work”";
const author = "Marc Benioff";
const words = quote.split(" ");
---

<div id="intro-overlay" aria-hidden="true">
	<p id="intro-text">
		{words.map((word) => <span>{word}&nbsp;</span>)}
		<br />
		<span class="author">{author}</span>
	</p>
</div>

<style>
	#intro-overlay {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--paper);
		padding: 1.5rem;
		text-align: center;
		transition: opacity 0.6s ease;
	}

	#intro-overlay.hidden {
		opacity: 0;
		pointer-events: none;
	}

	#intro-text {
		max-width: 40rem;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 3rem;
		color: var(--ink);
		text-shadow: 4px 4px 0 var(--yellow);
		margin: 0;
	}

	#intro-text span {
		display: inline-block;
		opacity: 0;
		transform: translateY(0.4em);
		filter: blur(4px);
		transition: opacity 0.7s ease, transform 0.7s ease, filter 0.7s ease;
	}

	#intro-text span.visible {
		opacity: 1;
		transform: translateY(0);
		filter: blur(0);
	}

	#intro-text span.author {
		font-size: 1.5rem;
	}
</style>

<script>
	const overlay = document.getElementById("intro-overlay");
	const pageContent = document.getElementById("page-content");
	const words = document.querySelectorAll<HTMLElement>("#intro-text span");
	const prefersReducedMotion = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	).matches;

	if (!overlay || words.length === 0) {
		pageContent?.classList.add("revealed");
	} else if (prefersReducedMotion) {
		overlay.classList.add("hidden");
		pageContent?.classList.add("revealed");
	} else {
		document.body.style.overflow = "hidden";

		// Group words by their rendered line (matching offsetTop) so a whole
		// wrapped line animates in together, rather than word by word.
		const lineMap = new Map<number, HTMLElement[]>();
		words.forEach((word) => {
			const top = word.offsetTop;
			const line = lineMap.get(top);
			if (line) {
				line.push(word);
			} else {
				lineMap.set(top, [word]);
			}
		});
		const lines = [...lineMap.values()];

		const stepMs = 500;
		lines.forEach((line, i) => {
			setTimeout(() => {
				line.forEach((word) => word.classList.add("visible"));
			}, i * stepMs);
		});

		const totalDelay = lines.length * stepMs + 1800;
		setTimeout(() => {
			overlay.classList.add("hidden");
			pageContent?.classList.add("revealed");
			document.body.style.overflow = "";
		}, totalDelay);
	}
</script>
