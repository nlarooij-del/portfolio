<div id="intro-overlay" aria-hidden="true">
	<div id="intro-emoji"></div>
	<p id="intro-text"></p>
</div>

<style>
	#intro-overlay {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		background: var(--paper);
		padding: 1.5rem;
		text-align: center;
		transition: opacity 0.6s ease;
	}

	#intro-overlay.hidden {
		opacity: 0;
		pointer-events: none;
	}

	#intro-emoji {
		font-size: 4rem;
		line-height: 1;
		opacity: 0;
		transform: translateY(0.4em);
		filter: blur(4px);
		transition: opacity 0.7s ease, transform 0.7s ease, filter 0.7s ease;
	}

	#intro-emoji:empty {
		display: none;
	}

	#intro-emoji.visible {
		opacity: 1;
		transform: translateY(0);
		filter: blur(0);
	}

	#intro-text {
		max-width: 66rem;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 3rem;
		line-height: 1;
		color: var(--ink);
		text-shadow: 4px 4px 0 var(--yellow);
		margin: 0;
	}

	/* :global() because these spans are created client-side (see the script
	   below) — Astro only stamps its scoping attribute on server-rendered
	   markup, so a scoped selector here would silently never match them. */
	#intro-text :global(span) {
		display: inline-block;
		opacity: 0;
		transform: translateY(0.4em);
		filter: blur(4px);
		transition: opacity 0.7s ease, transform 0.7s ease, filter 0.7s ease;
	}

	#intro-text :global(span.visible) {
		opacity: 1;
		transform: translateY(0);
		filter: blur(0);
	}

	#intro-text :global(span.subline) {
		font-family: var(--font-body);
		font-weight: 700;
		font-size: 1.25rem;
		color: #555;
		text-shadow: none;
	}
</style>

<script>
	const overlay = document.getElementById("intro-overlay");
	const pageContent = document.getElementById("page-content");
	const introEmoji = document.getElementById("intro-emoji");
	const introText = document.getElementById("intro-text");
	const prefersReducedMotion = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	).matches;

	const FALLBACK: { text: string; emoji: string } = {
		text: "Good day for looking at portfolios.",
		emoji: "",
	};

	const SKIP_KEY = "skipIntro";

	const WEATHER_ADJECTIVES: Record<number, string> = {
		0: "clear",
		1: "mostly clear",
		2: "partly cloudy",
		3: "cloudy",
		45: "foggy",
		48: "foggy",
		51: "drizzly",
		53: "drizzly",
		55: "drizzly",
		56: "icy",
		57: "icy",
		61: "rainy",
		63: "rainy",
		65: "rainy",
		66: "icy",
		67: "icy",
		71: "snowy",
		73: "snowy",
		75: "snowy",
		77: "snowy",
		80: "rainy",
		81: "rainy",
		82: "rainy",
		85: "snowy",
		86: "snowy",
		95: "stormy",
		96: "stormy",
		99: "stormy",
	};

	const WEATHER_EMOJIS: Record<number, string> = {
		0: "☀️",
		1: "🌤️",
		2: "⛅",
		3: "☁️",
		45: "🌫️",
		48: "🌫️",
		51: "🌦️",
		53: "🌦️",
		55: "🌦️",
		56: "🌨️",
		57: "🌨️",
		61: "🌧️",
		63: "🌧️",
		65: "🌧️",
		66: "🌨️",
		67: "🌨️",
		71: "❄️",
		73: "❄️",
		75: "❄️",
		77: "❄️",
		80: "🌦️",
		81: "🌧️",
		82: "⛈️",
		85: "🌨️",
		86: "🌨️",
		95: "⛈️",
		96: "⛈️",
		99: "⛈️",
	};

	function withTimeout<T>(promise: Promise<T>, ms: number): Promise<T> {
		return new Promise((resolve, reject) => {
			const timer = setTimeout(() => reject(new Error("timeout")), ms);
			promise.then(
				(value) => {
					clearTimeout(timer);
					resolve(value);
				},
				(err) => {
					clearTimeout(timer);
					reject(err);
				},
			);
		});
	}

	async function buildGreeting(): Promise<{ text: string; emoji: string }> {
		const geoRes = await fetch("https://ipwho.is/");
		const geo = await geoRes.json();
		if (!geo.success) throw new Error("geolocation failed");

		const { city, latitude, longitude } = geo;

		const weatherRes = await fetch(
			`https://api.open-meteo.com/v1/forecast?latitude=${latitude}&longitude=${longitude}&current=weather_code`,
		);
		const weather = await weatherRes.json();
		const code = weather.current?.weather_code;
		const adjective = WEATHER_ADJECTIVES[code] ?? "Unpredictable";
		const emoji = WEATHER_EMOJIS[code] ?? "🌈";
		const capitalized = adjective.charAt(0).toUpperCase() + adjective.slice(1);

		if (!city) throw new Error("missing city");

		return {
			text: `${capitalized} day in ${city}?
Perfect weather to look at my portfolio`,
			emoji,
		};
	}

	function renderWords(line: string) {
		if (!introText) return [] as HTMLElement[];
		introText.innerHTML = "";
		const rows = line.split("\n");
		const spans: HTMLElement[] = [];
		rows.forEach((row, i) => {
			row.split(" ").forEach((word, j) => {
				if (j > 0) introText.appendChild(document.createTextNode(" "));
				const span = document.createElement("span");
				span.textContent = word;
				if (i > 0) span.classList.add("subline");
				introText.appendChild(span);
				spans.push(span);
			});
			if (i < rows.length - 1) introText.appendChild(document.createElement("br"));
		});
		return spans;
	}

	async function init() {
		if (!overlay || !introText) {
			pageContent?.classList.add("revealed");
			return;
		}

		const cameFromShowcase = sessionStorage.getItem(SKIP_KEY);
		if (cameFromShowcase) sessionStorage.removeItem(SKIP_KEY);

		if (prefersReducedMotion || cameFromShowcase) {
			overlay.classList.add("hidden");
			pageContent?.classList.add("revealed");
			return;
		}

		document.body.style.overflow = "hidden";

		let greeting = FALLBACK;
		try {
			greeting = await withTimeout(buildGreeting(), 2500);
		} catch {
			greeting = FALLBACK;
		}

		if (introEmoji) introEmoji.textContent = greeting.emoji;

		const words = renderWords(greeting.text);
		if (words.length === 0) {
			overlay.classList.add("hidden");
			pageContent?.classList.add("revealed");
			document.body.style.overflow = "";
			return;
		}

		// Group words by their rendered line (matching offsetTop) so a whole
		// wrapped line animates in together, rather than word by word.
		const lineMap = new Map<number, HTMLElement[]>();
		words.forEach((word) => {
			const top = word.offsetTop;
			const group = lineMap.get(top);
			if (group) {
				group.push(word);
			} else {
				lineMap.set(top, [word]);
			}
		});
		const lines = [...lineMap.values()];

		const stepMs = 500;
		if (introEmoji && greeting.emoji) {
			setTimeout(() => introEmoji.classList.add("visible"), 0);
		}
		lines.forEach((lineWords, i) => {
			setTimeout(() => {
				lineWords.forEach((word) => word.classList.add("visible"));
			}, i * stepMs);
		});

		const totalDelay = lines.length * stepMs + 1800;
		setTimeout(() => {
			overlay.classList.add("hidden");
			pageContent?.classList.add("revealed");
			document.body.style.overflow = "";
		}, totalDelay);
	}

	init();
</script>
