<div id="intro-overlay" aria-hidden="true">
	<p id="intro-text"></p>
</div>

<style>
	#intro-overlay {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--paper);
		padding: 1.5rem;
		text-align: center;
		transition: opacity 0.6s ease;
	}

	#intro-overlay.hidden {
		opacity: 0;
		pointer-events: none;
	}

	#intro-text {
		max-width: 40rem;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 3rem;
		color: var(--ink);
		text-shadow: 4px 4px 0 var(--yellow);
		margin: 0;
	}

	#intro-text span {
		display: inline-block;
		opacity: 0;
		transform: translateY(0.4em);
		filter: blur(4px);
		transition: opacity 0.7s ease, transform 0.7s ease, filter 0.7s ease;
	}

	#intro-text span.visible {
		opacity: 1;
		transform: translateY(0);
		filter: blur(0);
	}

	#intro-text span.author {
		font-size: 1.5rem;
	}
</style>

<script>
	const overlay = document.getElementById("intro-overlay");
	const pageContent = document.getElementById("page-content");
	const introText = document.getElementById("intro-text");
	const prefersReducedMotion = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	).matches;

	const FALLBACK_LINE = "Hey there — hope you're having a good one today";

	const WEATHER_ADJECTIVES: Record<number, string> = {
		0: "clear",
		1: "mostly clear",
		2: "partly cloudy",
		3: "cloudy",
		45: "foggy",
		48: "foggy",
		51: "drizzly",
		53: "drizzly",
		55: "drizzly",
		56: "icy",
		57: "icy",
		61: "rainy",
		63: "rainy",
		65: "rainy",
		66: "icy",
		67: "icy",
		71: "snowy",
		73: "snowy",
		75: "snowy",
		77: "snowy",
		80: "rainy",
		81: "rainy",
		82: "rainy",
		85: "snowy",
		86: "snowy",
		95: "stormy",
		96: "stormy",
		99: "stormy",
	};

	function withTimeout<T>(promise: Promise<T>, ms: number): Promise<T> {
		return new Promise((resolve, reject) => {
			const timer = setTimeout(() => reject(new Error("timeout")), ms);
			promise.then(
				(value) => {
					clearTimeout(timer);
					resolve(value);
				},
				(err) => {
					clearTimeout(timer);
					reject(err);
				},
			);
		});
	}

	async function buildGreeting(): Promise<string> {
		const geoRes = await fetch("https://ipwho.is/");
		const geo = await geoRes.json();
		if (!geo.success) throw new Error("geolocation failed");

		const { city, latitude, longitude } = geo;

		const weatherRes = await fetch(
			`https://api.open-meteo.com/v1/forecast?latitude=${latitude}&longitude=${longitude}&current=temperature_2m,weather_code`,
		);
		const weather = await weatherRes.json();
		const temp = Math.round(weather.current?.temperature_2m);
		const code = weather.current?.weather_code;
		const adjective = WEATHER_ADJECTIVES[code] ?? "unpredictable";

		if (!city || Number.isNaN(temp)) throw new Error("incomplete weather data");

		return `It's a ${adjective} ${temp}°C in ${city} right now — hope you're having a good one`;
	}

	function renderWords(line: string) {
		if (!introText) return [] as HTMLElement[];
		introText.innerHTML = "";
		const words = line.split(" ");
		return words.map((word) => {
			const span = document.createElement("span");
			span.textContent = word;
			span.append(document.createTextNode(" "));
			introText.appendChild(span);
			return span;
		});
	}

	async function init() {
		if (!overlay || !introText) {
			pageContent?.classList.add("revealed");
			return;
		}

		if (prefersReducedMotion) {
			overlay.classList.add("hidden");
			pageContent?.classList.add("revealed");
			return;
		}

		document.body.style.overflow = "hidden";

		let line = FALLBACK_LINE;
		try {
			line = await withTimeout(buildGreeting(), 2500);
		} catch {
			line = FALLBACK_LINE;
		}

		const words = renderWords(line);
		if (words.length === 0) {
			overlay.classList.add("hidden");
			pageContent?.classList.add("revealed");
			document.body.style.overflow = "";
			return;
		}

		// Group words by their rendered line (matching offsetTop) so a whole
		// wrapped line animates in together, rather than word by word.
		const lineMap = new Map<number, HTMLElement[]>();
		words.forEach((word) => {
			const top = word.offsetTop;
			const group = lineMap.get(top);
			if (group) {
				group.push(word);
			} else {
				lineMap.set(top, [word]);
			}
		});
		const lines = [...lineMap.values()];

		const stepMs = 500;
		lines.forEach((lineWords, i) => {
			setTimeout(() => {
				lineWords.forEach((word) => word.classList.add("visible"));
			}, i * stepMs);
		});

		const totalDelay = lines.length * stepMs + 1800;
		setTimeout(() => {
			overlay.classList.add("hidden");
			pageContent?.classList.add("revealed");
			document.body.style.overflow = "";
		}, totalDelay);
	}

	init();
</script>
