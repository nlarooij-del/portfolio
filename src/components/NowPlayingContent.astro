---
export const prerender = false;

import { getLastPlayed } from "../lib/spotify";

const nowPlaying = await getLastPlayed();
---

{nowPlaying ? (
	<a
		class="now-playing"
		href={nowPlaying.url}
		target="_blank"
		rel="noopener noreferrer"
		aria-label={`Play “${nowPlaying.title}” by ${nowPlaying.artist} on Spotify`}
	>
		<div class="now-playing-art-wrap">
			{nowPlaying.albumArt && (
				<img class="now-playing-art" src={nowPlaying.albumArt} alt="" />
			)}
			<span class="now-playing-play" aria-hidden="true">▶</span>
		</div>
		<span class="now-playing-info">
			<span class="now-playing-title">{nowPlaying.title}</span>
			<span class="now-playing-artist">{nowPlaying.artist}</span>
		</span>
	</a>
) : (
	<>
		<p class="widget-body">[Song title]</p>
		<p class="widget-meta">[Artist]</p>
	</>
)}

<style>
	/* Duplicated from Hero.astro's shared widget styles — Astro's scoped CSS
	   doesn't cross into a child component's server-island-rendered markup. */
	.widget-body,
	.widget-meta {
		margin: 0;
	}

	.now-playing {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: inherit;
		text-decoration: none;
	}

	.now-playing-art-wrap {
		position: relative;
		flex-shrink: 0;
	}

	.now-playing-art {
		display: block;
		width: 48px;
		height: 48px;
		object-fit: cover;
		border: 2px solid var(--ink);
		border-radius: 0.4rem;
		box-shadow: 3px 3px 0 var(--ink);
	}

	.now-playing-play {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		border: 2px solid var(--ink);
		border-radius: 0.4rem;
		background: rgba(255, 255, 255, 0.55);
		color: var(--ink);
		font-size: 0.8rem;
		line-height: 1;
		opacity: 0;
		transition: opacity 0.15s ease;
	}

	.now-playing:hover .now-playing-play {
		opacity: 1;
	}

	.now-playing-info {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.now-playing-title {
		font-family: var(--font-display);
		font-weight: 700;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.now-playing-artist {
		font-size: var(--font-size-caption);
		opacity: 0.7;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
</style>
