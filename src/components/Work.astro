---
import { showcases } from "../data/showcases";
---

<section id="work">
	<h2>Selected works</h2>
	<div class="showcases">
		{showcases.map((item) => (
			<article class="showcase">
				<p class="category">{item.category}</p>
				<div class="showcase-row">
					<div class="showcase-copy">
						<h3>{item.title}</h3>
						<ul class="tags">
							{item.tags.map((tag) => (
								<li>{tag}</li>
							))}
						</ul>
						<a href={`/work/${item.slug}/`} class="button">View case study</a>
					</div>
					<div class="showcase-illustration">
						{item.cardImage ? (
							<img src={item.cardImage} alt={item.title} />
						) : (
							<p>[Illustration]</p>
						)}
					</div>
				</div>
			</article>
		))}
	</div>
</section>

<style>
	.showcases {
		display: grid;
		gap: 2rem;
	}

	.showcase-row {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
	}

	.showcase-illustration {
		flex: 1;
		height: 200px;
		border: 3px solid var(--ink);
		box-shadow: 5px 5px 0 var(--ink);
		background: var(--lavender);
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 0.5rem;
		color: var(--ink);
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.75rem;
		overflow: hidden;
	}

	.showcase-illustration img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
	}

	.showcase:nth-of-type(2) .showcase-illustration {
		background: var(--sky);
	}

	.showcase:nth-of-type(3) .showcase-illustration {
		background: var(--leaf);
	}

	.showcase-copy {
		flex-shrink: 0;
	}

	.showcase-copy h3 {
		margin-top: 0;
	}

	.category {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--coral);
	}

	@media (max-width: 480px) {
		.showcase-row {
			flex-direction: column;
		}
	}

	.tags {
		display: flex;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		margin: 0.5rem 0 0;
	}

	.tags li {
		border: 2px solid var(--ink);
		border-radius: 999px;
		padding: 0.2rem 0.7rem;
		font-family: var(--font-body);
		font-weight: 700;
		font-size: 0.8rem;
		background: var(--paper);
	}

	.button {
		display: inline-block;
		margin-top: 0.5rem;
	}
</style>
