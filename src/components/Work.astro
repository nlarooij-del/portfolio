---
import { showcases } from "../data/showcases";
---

<section id="work">
	<h2>Selected works</h2>
	<div class="showcases">
		{showcases.map((item) => (
			<article class="showcase">
				{item.variant !== "slim" && <p class="category">{item.category}</p>}
				{item.variant === "slim" ? (
					<a href={item.pdfUrl} target="_blank" rel="noopener noreferrer" class="showcase-card showcase-card--slim">
						<h3>{item.title}</h3>
						<span class="slim-icon" aria-hidden="true">↗</span>
					</a>
				) : (
					<a href={item.pdfUrl} target="_blank" rel="noopener noreferrer" class="showcase-card">
						<div class="showcase-copy">
							<div>
								<h3>{item.title}</h3>
								<ul class="tags">
									{item.tags.map((tag) => (
										<li>{tag}</li>
									))}
								</ul>
							</div>
							<span class="button">View case study <span aria-hidden="true">↗</span></span>
						</div>
						<div class="showcase-illustration">
							{item.cardImage ? (
								<img src={item.cardImage} alt={item.title} loading="lazy" />
							) : (
								<div class="placeholder">
									<span class="placeholder-emoji" aria-hidden="true">🖼️</span>
								</div>
							)}
						</div>
					</a>
				)}
			</article>
		))}
	</div>
</section>

<style>
	.showcases {
		display: grid;
		gap: 2rem;
	}

	.showcase-card {
		display: flex;
		align-items: stretch;
		border: 4px solid var(--ink);
		box-shadow: 8px 8px 0 var(--ink);
		background: #fff;
		overflow: hidden;
		color: inherit;
		text-decoration: none;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}

	.showcase-card:hover {
		transform: translate(-3px, -3px);
		box-shadow: 11px 11px 0 var(--ink);
	}

	.showcase-card:active {
		transform: translate(2px, 2px);
		box-shadow: 5px 5px 0 var(--ink);
	}

	.showcase-illustration {
		flex: 1 1 58%;
		align-self: center;
		padding: 2rem;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
	}

	.showcase-illustration:has(.placeholder) {
		align-self: stretch;
		padding: 0;
	}

	.showcase-illustration img {
		display: block;
		width: 100%;
		height: auto;
	}

	.placeholder {
		width: 100%;
		height: 100%;
		min-height: 20rem;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.placeholder-emoji {
		font-size: calc(var(--font-size-display-lg) * 2);
		line-height: 1;
		transform: rotate(-4deg);
		filter: drop-shadow(5px 5px 0 var(--ink));
	}

	.showcase:nth-of-type(2) .placeholder-emoji {
		transform: rotate(3deg);
	}

	.showcase:nth-of-type(3) .placeholder-emoji {
		transform: rotate(-2deg);
	}

	.showcase-copy {
		flex: 1 1 42%;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 2rem;
	}

	.showcase-copy h3 {
		margin-top: 0;
	}

	.category {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--font-size-overline);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--coral);
	}

	@media (max-width: 768px) {
		.showcase-card {
			flex-direction: column;
		}

		.showcase-illustration {
			order: -1;
			flex: none;
			align-self: stretch;
			width: 100%;
			/* The copy panel below already has its own 2rem top padding —
			   dropping this one keeps the visual-to-title gap equal to that
			   single 2rem instead of stacking both panels' padding. */
			padding-bottom: 0;
		}
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		margin: 0.5rem 0 0;
	}

	.tags li {
		flex-shrink: 0;
		white-space: nowrap;
		border: 2px solid var(--ink);
		border-radius: 999px;
		padding: 0.25rem 0.75rem;
		font-family: var(--font-body);
		font-weight: 700;
		font-size: var(--font-size-overline);
		background: var(--paper);
	}

	.button {
		display: inline-block;
		align-self: flex-start;
		margin-top: 1.5rem;
	}

	.showcase-card--slim {
		align-items: center;
		justify-content: space-between;
		padding: 1.5rem 2rem;
		gap: 1.5rem;
	}

	.showcase-card--slim h3 {
		margin: 0;
	}

	.slim-icon {
		flex-shrink: 0;
		font-size: var(--font-size-heading);
		transition: transform 0.15s ease;
	}

	.showcase-card--slim:hover .slim-icon {
		transform: translate(3px, -3px);
	}

	@media (max-width: 768px) {
		.showcase-card--slim {
			flex-direction: row;
		}
	}
</style>
