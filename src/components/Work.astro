---
import { showcases } from "../data/showcases";
---

<section id="work">
	<h2>Selected works</h2>
	<div class="showcases">
		{showcases.map((item) => (
			<article class="showcase">
				<p class="category">{item.category}</p>
				<a href={`/work/${item.slug}/`} class="showcase-card">
					<div class="showcase-copy">
						<div>
							<h3>{item.title}</h3>
							<ul class="tags">
								{item.tags.map((tag) => (
									<li>{tag}</li>
								))}
							</ul>
						</div>
						<span class="button">View case study</span>
					</div>
					<div class="showcase-illustration">
						{item.cardImage ? (
							<img src={item.cardImage} alt={item.title} />
						) : (
							<p>[Illustration]</p>
						)}
					</div>
				</a>
			</article>
		))}
	</div>
</section>

<style>
	.showcases {
		display: grid;
		gap: 2rem;
	}

	.showcase-card {
		display: flex;
		align-items: stretch;
		border: 4px solid var(--ink);
		box-shadow: 8px 8px 0 var(--ink);
		background: #fff;
		overflow: hidden;
		color: inherit;
		text-decoration: none;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}

	.showcase-card:hover {
		transform: translate(-3px, -3px);
		box-shadow: 11px 11px 0 var(--ink);
	}

	.showcase-card:active {
		transform: translate(2px, 2px);
		box-shadow: 5px 5px 0 var(--ink);
	}

	.showcase-illustration {
		flex: 1 1 58%;
		align-self: center;
		padding: 2rem;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		color: var(--ink);
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--font-size-overline);
	}

	.showcase-illustration img {
		display: block;
		width: 100%;
		height: auto;
	}

	.showcase-illustration p {
		padding: 0.5rem;
		background: var(--lavender);
	}

	.showcase:nth-of-type(2) .showcase-illustration p {
		background: var(--sky);
	}

	.showcase:nth-of-type(3) .showcase-illustration p {
		background: var(--leaf);
	}

	.showcase-copy {
		flex: 1 1 42%;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 2rem;
	}

	.showcase-copy h3 {
		margin-top: 0;
	}

	.category {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--font-size-overline);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--coral);
	}

	@media (max-width: 768px) {
		.showcase-card {
			flex-direction: column;
		}

		.showcase-illustration {
			order: -1;
			flex: none;
			align-self: stretch;
			width: 100%;
		}
	}

	.tags {
		display: flex;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		margin: 0.5rem 0 0;
	}

	.tags li {
		border: 2px solid var(--ink);
		border-radius: 999px;
		padding: 0.25rem 0.75rem;
		font-family: var(--font-body);
		font-weight: 700;
		font-size: var(--font-size-overline);
		background: var(--paper);
	}

	.button {
		display: inline-block;
		align-self: flex-start;
		margin-top: 1.5rem;
	}
</style>
