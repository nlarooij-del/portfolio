---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface ImageWithCaption {
	src: ImageMetadata;
	alt: string;
	caption?: string;
}

interface Props {
	// Two-image-two-label pattern: each cell owns its own label above its own image.
	before?: ImageWithCaption;
	after?: ImageWithCaption;
	// Single-image-split-label pattern: one image, two (or more) labels tracking
	// its halves — used where a single screenshot already shows both states.
	src?: ImageMetadata;
	alt?: string;
	labels?: string[];
}
const { before, after, src, alt, labels } = Astro.props;
---

{
	before && after ? (
		<div class="pair two-image">
			<div class="cell">
				<div class="label">
					<span class="tag">Before</span>
					{before.caption && <span class="caption">{before.caption}</span>}
				</div>
				<div class="frame">
					<Image src={before.src} alt={before.alt} />
				</div>
			</div>
			<div class="cell">
				<div class="label">
					<span class="tag">After</span>
					{after.caption && <span class="caption">{after.caption}</span>}
				</div>
				<div class="frame">
					<Image src={after.src} alt={after.alt} />
				</div>
			</div>
		</div>
	) : (
		src &&
		alt &&
		labels && (
			<div class="pair single-image">
				<div class="label-row">
					{labels.map((l) => (
						<span class="tag">{l}</span>
					))}
				</div>
				<div class="frame">
					<Image src={src} alt={alt} />
				</div>
			</div>
		)
	)
}

<style>
	.pair {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.two-image {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
		gap: var(--gap-image-pair);
		align-items: start;
	}
	.cell {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.label {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
		font-family: var(--font-mono);
		font-size: 11.5px;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--color-muted);
	}
	.tag {
		color: var(--color-ink);
	}
	.label .caption {
		color: var(--color-muted);
	}

	.label-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		font-family: var(--font-mono);
		font-size: 11.5px;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}
	.label-row .tag {
		color: var(--color-ink);
	}

	.frame {
		background: var(--color-white);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		overflow: hidden;
	}
	.frame :global(img) {
		width: 100%;
		height: auto;
		display: block;
	}
</style>
