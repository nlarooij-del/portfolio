---
import Eyebrow from './Eyebrow.astro';

interface Props {
	id: string;
	badge: string;
	eyebrow: string;
	title: string;
	first?: boolean;
}
const { id, badge, eyebrow, title, first = false } = Astro.props;
---

<div class="decision" class:list={{ first }}>
	<Eyebrow>{eyebrow}</Eyebrow>
	<div id={id} class="heading">
		<span class="badge">{badge}</span>
		<h3>{title}</h3>
	</div>
	<div class="body">
		<slot />
	</div>
</div>

<style>
	.decision {
		padding: 56px 0;
		border-top: 1px solid var(--color-border);
		scroll-margin-top: var(--scroll-margin-case);
	}
	.decision.first {
		padding-top: 0;
		border-top: none;
	}
	.decision :global(.eyebrow) {
		margin-bottom: 10px;
	}
	.heading {
		display: flex;
		align-items: center;
		gap: 11px;
		margin: 0 0 28px;
	}
	.badge {
		flex: 0 0 auto;
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.06em;
		color: var(--color-accent-blue);
		border: 1px solid rgba(31, 92, 245, 0.4);
		border-radius: var(--radius-pill);
		padding: 5px 11px;
	}
	h3 {
		margin: 0;
		font-size: var(--text-h3-decision);
		line-height: 1.15;
		font-weight: 600;
		letter-spacing: -0.025em;
	}
	.body {
		display: flex;
		flex-direction: column;
		gap: 24px;
		font-family: var(--font-serif);
		font-size: var(--text-body);
		line-height: 1.6;
		color: var(--color-body);
	}
	.body :global(p) {
		margin: 0;
		max-width: var(--measure-decision);
	}
	.body :global(ul),
	.body :global(ol) {
		margin: 0;
		padding-left: 20px;
		display: flex;
		flex-direction: column;
		gap: 6px;
		max-width: var(--measure-decision);
	}
</style>
