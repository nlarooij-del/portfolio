---
interface Props {
	title: string;
	first?: boolean;
}
const { title, first = false } = Astro.props;
---

<div class="item" class:list={{ first }}>
	<h3>{title}</h3>
	<div class="body">
		<slot />
	</div>
</div>

<style>
	.item {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
		gap: var(--gap-prose-lg);
		padding: 40px 0;
		border-top: 1px solid var(--color-border);
	}
	.item.first {
		padding-top: 0;
		border-top: none;
	}
	.item:last-child {
		padding-bottom: 0;
	}
	h3 {
		margin: 0;
		font-size: clamp(20px, 2.5vw, 24px);
		font-weight: 600;
		letter-spacing: -0.02em;
	}
	.body {
		display: flex;
		flex-direction: column;
		gap: 24px;
		font-family: var(--font-serif);
		font-size: var(--text-body);
		line-height: 1.6;
		color: var(--color-body);
	}
	.body :global(p) {
		margin: 0;
		max-width: var(--measure-process);
	}
	.body :global(strong) {
		font-family: var(--font-sans);
		font-weight: 600;
		color: var(--color-ink);
	}
</style>
