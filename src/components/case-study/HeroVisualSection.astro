---
interface Props {
	title: string;
}
const { title } = Astro.props;
---

<section data-screen-label={title} class="section">
	<div class="inner">
		<slot />
	</div>
</section>

<style>
	.section {
		padding: var(--space-section-block) var(--space-section-inline) 0;
	}
	.inner {
		max-width: var(--content-max-width);
		margin: 0 auto;
	}
</style>
