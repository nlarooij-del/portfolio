---
import StatGrid from './StatGrid.astro';

interface Props {
	heading: string;
	intro: string;
	stats: { figure: string; caption: string }[];
	statsMaxWidth?: string;
}
const { heading, intro, stats, statsMaxWidth } = Astro.props;
---

<section id="outcome" data-screen-label={heading} class="section">
	<div class="inner">
		<div class="head">
			<h2>{heading}</h2>
			<p class="intro">{intro}</p>
		</div>
		<div class="stats">
			<StatGrid stats={stats} maxWidth={statsMaxWidth} />
		</div>
		<slot />
	</div>
</section>

<style>
	.section {
		background: var(--color-surface);
		padding: var(--space-section-block) var(--space-section-inline) clamp(56px, 8vw, 96px);
		margin-top: var(--space-section-block);
	}
	.inner {
		max-width: var(--content-max-width);
		margin: 0 auto;
	}
	.head {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
		gap: var(--gap-prose-lg);
		align-items: end;
		padding-bottom: 48px;
	}
	h2 {
		margin: 0;
		font-size: var(--text-h2);
		line-height: 1.06;
		font-weight: 600;
		letter-spacing: -0.03em;
	}
	.intro {
		font-family: var(--font-serif);
		font-size: var(--text-outcome-summary);
		line-height: 1.5;
		color: var(--color-ink);
		margin: 0;
		max-width: var(--measure-outcome);
	}
	.stats {
		padding-bottom: 56px;
	}
</style>
