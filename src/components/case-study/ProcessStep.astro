---
interface Props {
	id: string;
	title: string;
	first?: boolean;
	last?: boolean;
}
const { id, title, first = false, last = false } = Astro.props;
---

<div
	id={id}
	class="process-step"
	class:list={{ first, last }}
>
	<h3>{title}</h3>
	<div class="body">
		<slot />
	</div>
</div>

<style>
	.process-step {
		padding: 44px 0;
		border-top: 1px solid var(--color-border);
		scroll-margin-top: var(--scroll-margin-case);
	}
	.process-step.first {
		padding-top: 0;
		padding-bottom: 44px;
		border-top: none;
	}
	.process-step.last {
		padding-bottom: 0;
	}
	h3 {
		margin: 0 0 24px;
		font-size: var(--text-h3-step);
		font-weight: 600;
		letter-spacing: -0.02em;
	}
	.body {
		display: flex;
		flex-direction: column;
		gap: 24px;
		font-family: var(--font-serif);
		font-size: var(--text-body);
		line-height: 1.6;
		color: var(--color-body);
	}
	.body :global(p) {
		margin: 0;
		max-width: var(--measure-process);
	}
	.body :global(ul),
	.body :global(ol) {
		margin: 0;
		padding-left: 20px;
		display: flex;
		flex-direction: column;
		gap: 8px;
		max-width: var(--measure-process);
	}
	.body :global(h4) {
		margin: 0 0 8px;
		font-size: 19px;
		font-weight: 600;
		letter-spacing: -0.015em;
	}
</style>
