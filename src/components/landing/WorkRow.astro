---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	id?: string;
	number: string;
	client: string;
	title: string;
	summary: string;
	disciplines: string[];
	thumbnail: ImageMetadata;
	thumbnailAlt: string;
	href?: string;
	comingSoon?: boolean;
	hideVisualOnMobile?: boolean;
	first?: boolean;
	/** The coming-soon teaser card: smaller fixed type, not the full case-card scale. */
	compact?: boolean;
}
const {
	id,
	number,
	client,
	title,
	summary,
	disciplines,
	thumbnail,
	thumbnailAlt,
	href,
	comingSoon = false,
	hideVisualOnMobile = false,
	first = false,
	compact = false,
} = Astro.props;

const Tag = href ? 'a' : 'div';
---

<Tag id={id} href={href} class="row" class:list={{ linkable: !!href, first, compact }}>
	<div class="visual" class:list={{ 'hide-mobile': hideVisualOnMobile }}>
		<div class="mock">
			<div class="toolbar" class:list={{ compact }}>
				<span></span><span></span><span></span>
				<span class="bar"></span>
			</div>
			<Image src={thumbnail} alt={thumbnailAlt} />
		</div>
	</div>
	<div class="text">
		<div class="eyebrow-row">
			<span class="number">{number}</span>
			<span class="client">{client}</span>
			{comingSoon && <span class="badge">Coming soon</span>}
		</div>
		<h3>{title}</h3>
		<p>{summary}</p>
		<div class="disciplines">
			{
				disciplines.map((d, i) => (
					<>
						{i > 0 && <span class="dot" />}
						<span>{d}</span>
					</>
				))
			}
		</div>
	</div>
</Tag>

<style>
	.row {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
		gap: clamp(20px, 3vw, 56px);
		align-items: center;
		padding: 44px 0;
		border-top: 1px solid var(--color-border);
		color: var(--color-ink);
	}
	/* Force the stack to trigger at the same breakpoint the rest of the page
	   uses for "mobile mode", instead of leaving it to auto-fit's own organic
	   collapse point (~480px). */
	@media (max-width: 760px) {
		.row {
			grid-template-columns: 1fr;
		}
	}
	.row.first {
		padding-top: 0;
		border-top: none;
	}
	.row.linkable:hover {
		background: #f7f9fd;
	}
	/* The compact teaser row uses flex, not grid, so the text column hugs
	   the narrower (max-width-capped) visual instead of sitting in a fixed
	   50/50 grid track like the real case-study rows do. */
	.row.compact {
		display: flex;
		flex-wrap: wrap;
	}
	.row.compact .visual {
		flex: 1 1 200px;
	}
	.row.compact .text {
		flex: 3 1 340px;
	}

	.visual {
		position: relative;
		aspect-ratio: 4 / 3;
		background: var(--pattern-hatch);
		overflow: hidden;
		display: flex;
		align-items: flex-start;
		justify-content: center;
	}
	@media (max-width: 760px) {
		.visual.hide-mobile {
			display: none;
		}
	}
	.row.compact .visual {
		max-width: 340px;
	}

	.mock {
		width: 84%;
		margin-top: 26px;
		background: var(--color-white);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-browser-mock);
		overflow: hidden;
		box-shadow: var(--shadow-browser-mock);
	}
	.row.compact .mock {
		margin-top: 22px;
	}
	.mock :global(img) {
		width: 100%;
		height: auto;
		display: block;
	}
	.toolbar {
		display: flex;
		align-items: center;
		gap: 5px;
		padding: 6px 8px;
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-border-subtle);
	}
	.toolbar span {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #c9cfdb;
	}
	.toolbar.compact {
		gap: 4px;
		padding: 5px 7px;
	}
	.toolbar.compact span {
		width: 5px;
		height: 5px;
	}
	.toolbar .bar {
		margin-left: 6px;
		width: auto;
		height: 9px;
		border-radius: 2px;
		flex: 1 1 auto;
		background: var(--color-border-subtle);
	}
	.toolbar.compact .bar {
		margin-left: 5px;
		height: 8px;
	}

	.eyebrow-row {
		display: flex;
		align-items: baseline;
		gap: 16px;
		margin-bottom: 16px;
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.05em;
		color: var(--color-muted);
	}
	.row.compact .eyebrow-row {
		gap: 14px;
	}
	.number {
		color: var(--color-accent-blue);
	}
	.client {
		text-transform: uppercase;
	}
	.badge {
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-size: 10px;
		padding: 3px 8px;
		background: var(--color-yellow);
		color: var(--color-yellow-ink);
	}
	h3 {
		margin: 0;
		font-size: clamp(23px, 3.3vw, 32px);
		line-height: 1.14;
		font-weight: 600;
		letter-spacing: -0.025em;
		max-width: 22ch;
	}
	.row.compact h3 {
		font-size: 22px;
		line-height: 1.2;
		letter-spacing: -0.02em;
		max-width: 30ch;
	}
	.text p {
		font-family: var(--font-serif);
		font-size: clamp(16px, 2vw, 18px);
		line-height: 1.55;
		color: var(--color-body);
		margin: 18px 0 24px;
		max-width: 52ch;
	}
	.row.compact .text p {
		font-size: 16px;
		line-height: 1.5;
		margin: 12px 0 16px;
		max-width: 60ch;
	}
	.disciplines {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 11px;
		font-family: var(--font-mono);
		font-size: 11.5px;
		color: var(--color-muted);
	}
	.row.compact .disciplines {
		gap: 7px 10px;
		font-size: 11px;
	}
	.dot {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: var(--color-dot);
		align-self: center;
	}

	/* Once the row stacks, title/summary switch to a single shared measure
	   instead of the side-by-side ch caps above. Selectors mirror the ones
	   being overridden so specificity ties resolve to this (later)
	   declaration rather than the earlier unconditional one. */
	@media (max-width: 760px) {
		h3,
		.row.compact h3 {
			max-width: 30ch;
		}
		.text p,
		.row.compact .text p {
			max-width: 60ch;
		}
	}
</style>
