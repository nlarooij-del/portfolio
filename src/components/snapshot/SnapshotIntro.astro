---
interface Props {
	title: string;
	backHref: string;
	intro: string;
	jumpLinks: { label: string; href: string }[];
}
const { title, backHref, intro, jumpLinks } = Astro.props;
---

<section id="top" data-screen-label={title} class="snapshot-intro">
	<div class="inner">
		<a href={backHref} class="back"><span>←</span>Back</a>
		<h1>{title}</h1>
		<p class="intro">{intro}</p>
		<div class="jump-links h-scroll">
			{
				jumpLinks.map((link) => (
					<a href={link.href}>
						<span class="arrow">↓</span>
						{link.label}
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.snapshot-intro {
		background: var(--gradient-hero);
		padding: clamp(32px, 5vw, 56px) var(--space-section-inline) 28px;
	}
	.inner {
		max-width: var(--content-max-width);
		margin: 0 auto;
	}
	.back {
		display: inline-flex;
		align-items: baseline;
		gap: 8px;
		margin: 0 0 28px;
		font-family: var(--font-mono);
		font-size: var(--text-mono-label);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-body);
	}
	.back:hover {
		color: var(--color-ink);
	}
	h1 {
		margin: 0;
		max-width: 24ch;
		font-size: clamp(31px, 6vw, 66px);
		line-height: 1.02;
		letter-spacing: -0.035em;
		font-weight: 600;
		text-wrap: pretty;
	}
	.intro {
		font-family: var(--font-serif);
		font-size: var(--text-lede);
		line-height: 1.55;
		color: var(--color-body);
		max-width: 70ch;
		margin: clamp(24px, 3.4vw, 36px) 0 0;
	}
	.jump-links {
		gap: clamp(20px, 3.4vw, 44px);
		margin: clamp(28px, 4vw, 44px) 0 0;
		padding-top: 28px;
		border-top: 1px solid rgba(17, 17, 17, 0.18);
		font-family: var(--font-mono);
		font-size: var(--text-mono-label);
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}
	.jump-links a {
		flex: 0 0 auto;
		display: inline-flex;
		align-items: baseline;
		gap: 7px;
		color: var(--color-body);
	}
	.jump-links a:hover {
		color: var(--color-ink);
	}
	.jump-links .arrow {
		opacity: 0.45;
	}
</style>
